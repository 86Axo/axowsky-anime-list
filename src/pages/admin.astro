---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
import { STATUSES } from '../lib/types';
---

<Layout title={`Admin · ${SITE.title}`} description="Private annotation editor." noindex path="/admin">
  <header class="topbar">
    <div class="wrap topbar__inner">
      <a class="brand" href="/">← {SITE.nickname}</a>
      <span class="adm-user" id="adm-user"></span>
      <button class="btn" id="adm-logout" type="button" hidden>Sign out</button>
      <button class="icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="Switch color theme">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
      </button>
    </div>
  </header>

  <main class="wrap adm">
    <div class="adm-head">
      <h1 class="adm-title">Admin</h1>
      <p class="adm-summary" id="adm-summary"></p>
    </div>
    <p class="adm-banner" id="adm-banner" role="alert" hidden></p>

    <div class="tabs adm-tabs" role="group" aria-label="Admin sections">
      <button class="tab" type="button" data-panel="notes" aria-pressed="true">Notes and scores</button>
      <button class="tab" type="button" data-panel="top" aria-pressed="false">Top 10 order</button>
    </div>

    <!-- Notes and scores -->
    <section id="panel-notes" aria-label="Notes and scores">
      <p class="adm-help">Pick a title to set your own score, a distinction, tags, favorite character and review. Changes appear on the public page as soon as you save.</p>
      <div class="filters adm-filters">
        <div class="field field--search">
          <label class="vh" for="adm-search">Search titles</label>
          <input class="input" id="adm-search" type="search" placeholder="Search titles" autocomplete="off" spellcheck="false" />
        </div>
        <div class="field">
          <label class="vh" for="adm-status">Status</label>
          <select class="select" id="adm-status">
            <option value="">All statuses</option>
            {STATUSES.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label class="vh" for="adm-sort">Sort</label>
          <select class="select" id="adm-sort">
            <option value="title">Sort: title</option>
            <option value="score">Sort: my score</option>
            <option value="added">Sort: recently added</option>
          </select>
        </div>
        <label class="adm-check"><input type="checkbox" id="adm-only" /> With notes only</label>
        <span class="adm-count" id="adm-count" role="status"></span>
      </div>
      <ul class="adm-list" id="adm-list"></ul>
      <p class="adm-none" id="adm-none" hidden>No title matches these filters.</p>
    </section>

    <!-- Top 10 order -->
    <section id="panel-top" aria-label="Top 10 order" hidden>
      <p class="adm-help">
        The Top 10 is sorted by score. Where several titles share a score, you decide their order here: move them with the arrows, then save.
        Titles you have not placed are ordered by date added.
      </p>
      <div id="top-groups"></div>
      <div class="adm-actions adm-actions--sticky">
        <button class="btn btn--primary" type="button" id="top-save" disabled>Save order</button>
        <button class="btn" type="button" id="top-reset">Back to automatic order</button>
        <span class="adm-status" id="top-status" role="status"></span>
      </div>
    </section>
  </main>

  <template id="adm-editor">
    <form class="adm-form" novalidate>
      <fieldset class="adm-block">
        <legend>My score</legend>
        <div class="adm-score">
          <input class="input adm-score__num" name="refinedScore" type="number" min="1" max="100" step="1" inputmode="numeric" aria-label="Refined score, 1 to 100" />
          <input class="adm-score__range" type="range" min="1" max="100" step="1" data-range aria-label="Refined score slider" />
          <span class="adm-score__preview" data-preview></span>
        </div>
        <p class="adm-hint" data-score-hint></p>
      </fieldset>

      <fieldset class="adm-block">
        <legend>Favorite character</legend>
        <div class="adm-char">
          <img class="fav__avatar adm-char__avatar" data-avatar width="40" height="40" alt="" hidden />
          <input class="input" name="favoriteCharacter" type="text" maxlength="80" autocomplete="off" placeholder="Type a name or pick below" aria-label="Favorite character" />
        </div>
        <div class="adm-cast" data-cast hidden></div>
        <p class="adm-hint">Pick a character to get its picture, or type a name: a first name or nickname is enough.</p>
      </fieldset>

      <fieldset class="adm-block">
        <legend>Distinction</legend>
        <label class="adm-check"><input type="checkbox" data-honor /> Single this title out</label>
        <input class="input" name="distinction" type="text" maxlength="40" autocomplete="off" placeholder="Honorable mention" aria-label="Distinction label" disabled />
        <p class="adm-hint">For a title that earned a mention without being a top score. The label is shown on the page, for example “Best soundtrack”.</p>
      </fieldset>

      <fieldset class="adm-block">
        <legend>Tags</legend>
        <div class="adm-tags">
          <ul class="adm-tags__list" data-tags aria-label="Tags on this title"></ul>
          <input class="input adm-tags__input" name="tags" type="text" autocomplete="off" placeholder="Add a tag and press Enter" aria-label="Add a tag" />
        </div>
        <div class="adm-suggest" data-suggest hidden></div>
      </fieldset>

      <fieldset class="adm-block adm-block--wide">
        <legend>Review</legend>
        <textarea class="input" name="review" rows="4" maxlength="2000" placeholder="A few sentences shown on the public page" aria-label="Review"></textarea>
        <p class="adm-hint adm-hint--end" data-count></p>
      </fieldset>

      <div class="adm-actions">
        <button class="btn btn--primary" type="submit" data-save disabled>Save</button>
        <button class="btn" type="button" data-discard disabled>Discard changes</button>
        <button class="btn adm-danger" type="button" data-clear>Remove all notes</button>
        <span class="adm-status" role="status"></span>
      </div>
    </form>
  </template>

  <script src="../scripts/admin.ts"></script>
</Layout>

<style is:global>
  .adm {
    padding-block: 2.5rem 6rem;
  }
  .adm-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-block-end: 1.25rem;
  }
  .adm-title {
    font-size: var(--fs-xl);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .adm-summary,
  .adm-user,
  .adm-count,
  .adm-status,
  .adm-hint {
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .adm-user {
    margin-inline-start: auto;
  }
  .adm-banner {
    margin-block-end: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }
  .adm-tabs {
    margin-block-end: 1.5rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid var(--border);
    overflow: visible;
  }
  .adm-help {
    max-inline-size: 68ch;
    margin-block-end: 1.25rem;
    color: var(--text-2);
  }
  .adm-filters {
    margin-block-end: 0.75rem;
  }
  .adm-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .adm-count {
    margin-inline-start: auto;
  }
  .adm-none {
    padding-block: 2rem;
    color: var(--text-2);
  }

  /* Rows */
  .adm-list {
    border-block-start: 1px solid var(--border-strong);
  }
  .adm-row {
    border-block-end: 1px solid var(--border);
  }
  .adm-row[data-open] {
    background: color-mix(in oklch, var(--surface-2) 55%, transparent);
  }
  .adm-row__head {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto auto;
    gap: 0.875rem;
    align-items: center;
    inline-size: 100%;
    padding: 0.5rem 0.5rem 0.5rem 0;
    background: none;
    border: 0;
    text-align: start;
    cursor: pointer;
  }
  .adm-row__head:hover .adm-row__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .adm-row__title {
    display: block;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .adm-row__meta {
    display: block;
    color: var(--text-2);
    font-size: var(--fs-sm);
  }
  .adm-row__marks {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    max-inline-size: 16rem;
  }
  .adm-mark {
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--fs-xs);
    line-height: 1.6;
    white-space: nowrap;
  }
  .adm-row__chevron {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-inline: 0.375rem;
    border-inline-end: 1.5px solid var(--text-3);
    border-block-end: 1.5px solid var(--text-3);
    transform: rotate(45deg);
    transition: transform var(--fast) var(--ease);
  }
  .adm-row[data-open] .adm-row__chevron {
    transform: rotate(-135deg);
  }

  /* Editor */
  .adm-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    padding: 0.75rem 0.5rem 1.5rem 3.375rem;
  }
  .adm-block {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .adm-block--wide,
  .adm-actions {
    grid-column: 1 / -1;
  }
  .adm-block legend {
    padding: 0;
    margin-block-end: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .adm-hint--end {
    text-align: end;
  }
  .adm-score {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
  }
  .adm-score__range {
    inline-size: 100%;
    accent-color: var(--accent);
  }
  .adm-score__preview {
    min-inline-size: 9.5rem;
  }
  .adm-char {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .adm-char__avatar {
    inline-size: 2.5rem;
    block-size: 2.5rem;
  }
  .adm-cast,
  .adm-suggest,
  .adm-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .adm-cast {
    max-block-size: 9.5rem;
    overflow: auto;
    padding: 0.125rem;
  }
  .adm-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.625rem 0.125rem 0.125rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color var(--fast) var(--ease), background var(--fast) var(--ease);
  }
  .adm-pill:hover {
    border-color: var(--border-strong);
  }
  .adm-pill[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  .adm-pill img {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
    background: var(--surface-2);
  }
  .adm-pill--text {
    padding-inline-start: 0.625rem;
  }
  .adm-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .adm-tags__list:empty {
    display: none;
  }
  .adm-tags__input {
    flex: 1 1 12rem;
    inline-size: auto;
  }
  .adm-form textarea.input {
    block-size: auto;
    padding-block: 0.5rem;
    line-height: 1.5;
    resize: vertical;
  }
  .adm-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .adm-actions--sticky {
    position: sticky;
    inset-block-end: 0;
    margin-block-start: 1rem;
    padding-block: 0.875rem;
    background: var(--bg);
    border-block-start: 1px solid var(--border);
  }
  .btn:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .adm-danger {
    margin-inline-start: auto;
    color: var(--st-dropped);
  }
  .adm-status[data-kind='dirty']::before {
    content: '';
    display: inline-block;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    margin-inline-end: 0.375rem;
    border-radius: 50%;
    background: var(--st-on-hold);
  }
  .adm-status[data-kind='ok'] {
    color: var(--st-watching);
  }
  .adm-status[data-kind='error'] {
    color: var(--st-dropped);
  }

  /* Top 10 order */
  .top-group {
    margin-block-end: 2rem;
  }
  .top-group__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--border-strong);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }
  .top-row {
    display: grid;
    grid-template-columns: 2rem 2rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.375rem;
    border-block-end: 1px solid var(--border);
  }
  .top-row__rank {
    color: var(--text-3);
    font-size: var(--fs-md);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
  .top-row[data-in-top] .top-row__rank {
    color: var(--accent);
    font-weight: 600;
  }
  .top-row:not([data-in-top]) .top-row__title {
    color: var(--text-2);
  }
  .top-row[data-cut] {
    border-block-end: 2px solid var(--accent);
  }
  .top-row__moves {
    display: flex;
    gap: 0.25rem;
  }
  .top-row__moves .icon-btn {
    inline-size: 2rem;
    block-size: 2rem;
  }
  .top-row__moves .icon-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .top-cutnote {
    padding-block: 0.375rem;
    color: var(--accent);
    font-size: var(--fs-xs);
    letter-spacing: 0.02em;
  }

  @media (max-width: 48rem) {
    .adm-form {
      grid-template-columns: minmax(0, 1fr);
      padding-inline-start: 0;
    }
    .adm-row__marks {
      display: none;
    }
    .adm-row__head {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }
    .adm-score {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
    .adm-score__preview {
      grid-column: 1 / -1;
    }
    .adm-danger {
      margin-inline-start: 0;
    }
  }
</style>
